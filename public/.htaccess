<IfModule mod_rewrite.c>
  RewriteEngine On

  # Normalize the base
  RewriteBase /

  # Affiliate funnel redirects (YouTube descriptions → referral programs)
  # /cheapestvps, /cheapestn8nvps, /forexbroker are ALSO configured in HestiaCP server config (those take precedence);
  # these repo copies are the fallback so the funnel survives a server-config reset
  RewriteRule ^forextrading/?$ https://lanreenlight.com/forexbroker [R=301,L]
  RewriteRule ^forexbroker/?$ https://track.deriv.com/_kIunlnHY-5BMjdsyM5hasGNd7ZgqdRLk/1/ [R=302,L]
  RewriteRule ^cheapestvps/?$ https://www.dpbolvw.net/click-101311044-14573812 [R=301,L]
  RewriteRule ^cheapestn8nvps/?$ https://www.kqzyfj.com/click-101311044-17183968 [R=301,L]
  RewriteRule ^cheapest-openclaw-vps/?$ https://www.kqzyfj.com/click-101311044-17245853 [R=301,L]
  # VPS plan funnel (all plans share one Contabo CJ link until per-plan CJ tracking IDs are created)
  RewriteRule ^vps6/?$ https://www.dpbolvw.net/click-101311044-14573812 [R=301,L]
  RewriteRule ^vps8/?$ https://www.dpbolvw.net/click-101311044-14573812 [R=301,L]
  RewriteRule ^vps12/?$ https://www.dpbolvw.net/click-101311044-14573812 [R=301,L]

  # Serve prerendered HTML at extensionless URLs (e.g. /guides/n8n-automation)
  # Must run before the directory check: /blog is both a route and a physical directory
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Allow access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # No SPA fallback: every route ships as a prerendered .html file, so anything
  # unmatched is genuinely unknown and must 404 (soft-404s hurt indexation)
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml text/markdown
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/markdown "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
